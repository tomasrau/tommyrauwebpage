---
import Layout from "../layouts/Layout.astro";
import Terminal from "../components/ui/Terminal.astro";
import Metric from "../components/ui/Metric.astro";
import About from "../components/sections/About.astro";
import CaseStudies from "../components/sections/CaseStudies.astro";
import Experience from "../components/sections/Experience.astro";
import Contact from "../components/sections/Contact.astro";
---

<Layout
  title="Tomás Rau | Economía, Business Intelligence y Financial Analytics"
  description="Economista especializado en Business Intelligence, analítica financiera, estrategia tecnológica y toma de decisiones basada en datos."
>
  <!-- Hero Section / Shell de Validación Visual -->
  <section id="inicio" class="section-container scroll-mt-28 min-h-screen flex items-center justify-center !pt-24 !pb-16 md:!pt-32 md:!pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center w-full">
      
      <!-- Columna Izquierda: Copias, Título y Llamados a la Acción -->
      <div class="lg:col-span-7 flex flex-col gap-6">
        <!-- Eyebrow Tagline -->
        <span class="text-accent text-xs font-mono tracking-widest uppercase">
          Economía · Business Intelligence · Finanzas
        </span>
        
        <!-- Main Heading -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-extrabold text-slate-50 tracking-tight leading-[1.15] max-w-3xl">
          Economía, datos y estrategia para decisiones más inteligentes.
        </h1>
        
        <!-- Core Narrative Description -->
        <p class="text-muted text-base md:text-lg leading-relaxed max-w-2xl">
          Soy <strong class="text-slate-100 font-semibold font-display">Tomás Rau</strong>, economista especializado en Business Intelligence, analítica financiera y tecnología estratégica. Diseño e implemento arquitecturas de datos, reportería avanzada y modelos cuantitativos enfocados en maximizar el valor corporativo y refinar la toma de decisiones empresariales.
        </p>
        
        <!-- Navigation/CTA triggers -->
        <div class="flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-3 sm:gap-4 mt-2">
          <a
            href="#proyectos"
            class="px-6 py-3.5 rounded-lg bg-accent-bronze hover:bg-accent-bronze-hover text-obsidian-bg font-display font-bold text-sm text-center tracking-wide transition-all duration-200 shadow-lg shadow-accent-bronze/10 focus:outline-none active:scale-[0.98]"
          >
            Ver proyectos
          </a>
          <a
            href="#contacto"
            class="px-6 py-3.5 rounded-lg border border-white/10 hover:border-accent-bronze text-slate-200 hover:text-accent-bronze font-display font-bold text-sm text-center tracking-wide transition-all duration-200 glass-surface focus:outline-none active:scale-[0.98]"
          >
            Contactar
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Componente de Terminal Analítica -->
      <div class="lg:col-span-5 w-full flex items-center justify-center relative">
        <!-- Aura resplandeciente de fondo para dar profundidad a la terminal -->
        <div class="absolute -inset-4 bg-accent-bronze/5 rounded-full blur-[80px] pointer-events-none"></div>
        
        <Terminal />
      </div>

    </div>
  </section>

  <!-- Sección de Capacidades / Expertise (ID: expertise para concordar con Header.astro) -->
  <section id="expertise" class="section-container scroll-mt-28 border-t border-white/5 !py-20 md:!py-28">
    <div class="flex flex-col gap-12 w-full">
      
      <!-- Cabecera de la Sección -->
      <div class="flex flex-col gap-4 max-w-3xl">
        <!-- Eyebrow Tagline -->
        <span class="text-accent text-xs font-mono tracking-widest uppercase">
          Capacidades estratégicas
        </span>
        
        <!-- H2 Heading -->
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-extrabold text-slate-50 tracking-tight leading-tight">
          Un perfil híbrido entre economía, datos y tecnología.
        </h2>
        
        <!-- Contextual Description -->
        <p class="text-muted text-base md:text-lg leading-relaxed">
          La integración entre el razonamiento económico, una sólida arquitectura de BI, la analítica financiera avanzada y la toma de decisiones estratégicas estructuradas permite formular soluciones analíticas de alto impacto, traduciendo grandes volúmenes de datos en ventajas competitivas reales.
        </p>
      </div>

      <!-- Grid de Componentes Metric -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-6 w-full">
        <Metric 
          value="+8 años" 
          label="BI & Analytics" 
          description="Experiencia en reporting ejecutivo, automatización, modelos de datos y visualización avanzada." 
          trend="Arquitectura analítica" 
        />
        <Metric 
          value="Finanzas" 
          label="Financial Analytics" 
          description="Análisis de indicadores, mercados, escenarios y criterios de evaluación para decisiones financieras." 
          trend="Lectura estratégica" 
        />
        <Metric 
          value="Estrategia" 
          label="Tech & Business" 
          description="Diseño de soluciones digitales, procesos de transformación y sistemas de decisión basados en datos." 
          trend="Visión ejecutiva" 
        />
        <Metric 
          value="Data-driven" 
          label="Decision Intelligence" 
          description="Traducción de datos complejos en narrativas, modelos y recomendaciones accionables." 
          trend="Insight aplicado" 
        />
      </div>

    </div>
  </section>

  <!-- Nuevas Secciones del Sitio -->
  <About />
  <CaseStudies />
  <Experience />
  <Contact />
</Layout>

---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import FloatingNav from "../components/core/FloatingNav.astro";
import ResearchIndex from "../components/sections/ResearchIndex.astro";
import Method from "../components/sections/Method.astro";
import ISLMModel from "../components/sections/ISLMModel.astro";
import Experience from "../components/sections/Experience.astro";
import Contact from "../components/sections/Contact.astro";
// Sólo en la home en español: la landing del webinar existe únicamente en
// castellano, así que en /en/ ofrecería en inglés algo que después se lee
// en otro idioma.
import WebinarPromo from "../components/core/WebinarPromo.astro";
---

<Layout
  lang="es"
  alternateUrl="/en/"
  title="Tomás Rau | Research cuantitativo, mercados de capitales y analítica financiera"
  description="Economista especializado en research cuantitativo, mercados de capitales y la arquitectura de datos que soporta el análisis financiero."
>
  <Hero lang="es" />
  <FloatingNav lang="es" />
  <ResearchIndex lang="es" />
  <Method lang="es" />
  <ISLMModel lang="es" />
  <Experience lang="es" />
  <Contact lang="es" />

  <WebinarPromo />
</Layout>

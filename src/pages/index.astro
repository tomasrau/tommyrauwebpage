---
import Layout from "../layouts/Layout.astro";
import Terminal from "../components/ui/Terminal.astro";
---

<Layout>
  <!-- Hero Section / Shell de Validación Visual -->
  <section id="inicio" class="section-container min-h-screen flex items-center justify-center pt-24 md:pt-32">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center w-full">
      
      <!-- Columna Izquierda: Copias, Título y Llamados a la Acción -->
      <div class="lg:col-span-7 flex flex-col gap-6">
        <!-- Eyebrow Tagline -->
        <span class="text-accent text-xs font-mono tracking-widest uppercase">
          Economía · Business Intelligence · Finanzas
        </span>
        
        <!-- Main Heading -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-extrabold text-slate-50 tracking-tight leading-[1.15]">
          Economía, datos y estrategia para decisiones más inteligentes.
        </h1>
        
        <!-- Core Narrative Description -->
        <p class="text-muted text-base md:text-lg leading-relaxed max-w-2xl">
          Soy <strong class="text-slate-100 font-semibold font-display">Tomás Rau</strong>, economista especializado en Business Intelligence, analítica financiera y tecnología estratégica. Diseño e implemento arquitecturas de datos, reportería avanzada y modelos cuantitativos enfocados en maximizar el valor corporativo y refinar la toma de decisiones empresariales.
        </p>
        
        <!-- Navigation/CTA triggers -->
        <div class="flex flex-wrap items-center gap-4 mt-2">
          <a
            href="#proyectos"
            class="px-6 py-3.5 rounded-lg bg-accent-bronze hover:bg-accent-bronze-hover text-obsidian-bg font-display font-bold text-sm tracking-wide transition-all duration-200 shadow-lg shadow-accent-bronze/10 focus:outline-none active:scale-[0.98]"
          >
            Ver proyectos
          </a>
          <a
            href="#contacto"
            class="px-6 py-3.5 rounded-lg border border-white/10 hover:border-accent-bronze text-slate-200 hover:text-accent-bronze font-display font-bold text-sm tracking-wide transition-all duration-200 glass-surface focus:outline-none active:scale-[0.98]"
          >
            Contactar
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Componente de Terminal Analítica -->
      <div class="lg:col-span-5 w-full flex items-center justify-center relative">
        <!-- Aura resplandeciente de fondo para dar profundidad a la terminal -->
        <div class="absolute -inset-4 bg-accent-bronze/5 rounded-full blur-[80px] pointer-events-none"></div>
        
        <Terminal />
      </div>

    </div>
  </section>
</Layout>



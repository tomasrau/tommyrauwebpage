---
// FocusPanel.astro - Panel de foco del hero. Reemplaza la terminal decorativa simulada
// (prohibida por §2.3 del design system: "terminales de código decorativas").
// Elemento plano de superficie 2, con lista de nodo (§3.5/§3.11) y una sola cifra en
// --font-data como acento único de la vista.

interface FocusItem {
  label: string;
}

interface Props {
  heading: string;
  value: string;
  valueLabel: string;
  items: FocusItem[];
}

const { heading, value, valueLabel, items } = Astro.props;
---

<div class="focus-panel">
  <div class="focus-panel-header">
    <span class="focus-panel-heading">{heading}</span>
  </div>

  <div class="focus-value">
    <span class="focus-value-number">{value}</span>
    <span class="focus-value-label">{valueLabel}</span>
  </div>

  <ul class="focus-list">
    {items.map((item) => (
      <li class="focus-item">
        <span class="focus-node" aria-hidden="true"></span>
        {item.label}
      </li>
    ))}
  </ul>
</div>

<style>
  .focus-panel {
    background: var(--surface-raised);
    border: var(--hairline) solid var(--border-strong);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    width: 100%;
    max-width: 22rem;
  }

  .focus-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-3);
    border-bottom: var(--hairline) solid var(--border);
  }

  .focus-panel-heading {
    font: var(--label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .focus-value {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .focus-value-number {
    display: inline-block;
    width: fit-content;
    font: var(--data-xl);
    color: var(--text-primary);
    background: var(--accent-substrate);
    box-shadow: inset 0 -3px 0 var(--accent-rule);
    padding: 2px 10px 4px;
  }

  .focus-value-label {
    font: var(--ui-s);
    color: var(--text-secondary);
  }

  .focus-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .focus-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font: var(--ui-m);
    color: var(--text-secondary);
  }

  .focus-node {
    width: var(--node-dot);
    height: var(--node-dot);
    background: var(--text-secondary);
    flex-shrink: 0;
  }
</style>

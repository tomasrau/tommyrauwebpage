---
// Metric.astro - Tarjeta de dato plana (§2.1 superficie nivel 1 + §3.3), sin sombra ni radio.
interface Props {
  value: string;
  label: string;
  description?: string;
  tag?: string;
}

const { value, label, description, tag } = Astro.props;
---

<div class="metric-card">
  <div class="metric-header">
    <span class="metric-label">{label}</span>
    {tag && <span class="metric-tag">{tag}</span>}
  </div>

  <div class="metric-value">{value}</div>

  {description && <p class="metric-description">{description}</p>}
</div>

<style>
  .metric-card {
    height: 100%;
    background: var(--surface);
    border: var(--hairline) solid var(--border);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition: background-color var(--dur-fast) var(--ease-in-out), border-color var(--dur-fast) var(--ease-in-out);
  }

  .metric-card:hover {
    border-color: var(--border-strong);
  }

  .metric-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .metric-label {
    font: var(--label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .metric-tag {
    font: var(--ui-s);
    color: var(--text-secondary);
    background: var(--border);
    padding: 5px 10px;
    border-radius: var(--radius-1);
    white-space: nowrap;
  }

  .metric-value {
    font: var(--data-xl);
    color: var(--text-primary);
    margin: var(--space-1) 0;
  }

  .metric-description {
    font: var(--body-s);
    color: var(--text-secondary);
    padding-top: var(--space-2);
    border-top: var(--hairline) solid var(--border);
    margin: var(--space-1) 0 0;
  }
</style>

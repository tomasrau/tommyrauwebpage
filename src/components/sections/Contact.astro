---
// Contact.astro - Sección "Contacto"
interface Props {
  lang?: "es" | "en";
}
const { lang = "es" } = Astro.props;

const copy = {
  es: {
    eyebrow: "Contacto",
    heading: "Conversemos si necesitás transformar datos, finanzas o estrategia en decisiones concretas.",
    desc: "Disponible para consultorías especializadas, proyectos integrales de Business Intelligence, modelación macro-financiera y diseño de plataformas analíticas corporativas.",
    email: "Enviar correo",
    linkedin: "LinkedIn",
    github: "GitHub",
    topics: [
      { title: "Consultoría / proyectos", desc: "Asesoramiento integral y estructuración de modelos analíticos a medida, auditoría de canalizaciones de Business Intelligence y optimización financiera corporativa." },
      { title: "Colaboraciones profesionales", desc: "Co-diseño de plataformas digitales, integración en equipos directivos temporales o estructuración de sinergias operativas basadas en datos y finanzas de mercado." },
      { title: "Contenido, medios y speaking", desc: "Charlas magistrales y paneles técnicos sobre economía, valor del dato corporativo, arquitectura de reportes avanzados e impacto estratégico de la tecnología en la toma de decisiones." },
    ],
  },
  en: {
    eyebrow: "Contact",
    heading: "Let's talk if you need to turn data, finance or strategy into concrete decisions.",
    desc: "Available for specialized consulting, end-to-end Business Intelligence projects, macro-financial modeling and corporate analytical platform design.",
    email: "Send email",
    linkedin: "LinkedIn",
    github: "GitHub",
    topics: [
      { title: "Consulting / projects", desc: "End-to-end advisory and custom analytical model design, Business Intelligence pipeline audits and corporate financial optimization." },
      { title: "Professional collaborations", desc: "Co-design of digital platforms, temporary integration into leadership teams, or structuring operational synergies based on data and market finance." },
      { title: "Content, media and speaking", desc: "Keynotes and technical panels on economics, corporate data value, advanced reporting architecture and the strategic impact of technology on decision-making." },
    ],
  },
} as const;

const t = copy[lang];
---

<section id="contacto" class="section">
  <div class="section-inner contact-grid">
    <div class="contact-narrative">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 class="contact-heading">{t.heading}</h2>
      <p class="contact-desc">{t.desc}</p>

      <div class="contact-actions">
        <a href="mailto:tomasrau@lorenz.ar" class="btn btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          {t.email}
        </a>
        <a href="https://www.linkedin.com/in/tomasezequielrau" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>
          </svg>
          {t.linkedin}
        </a>
        <a href="https://github.com/tomasrau" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>
          </svg>
          {t.github}
        </a>
      </div>
    </div>

    <div class="contact-topics">
      {t.topics.map((topic) => (
        <div class="topic-card card">
          <h3 class="topic-title">{topic.title}</h3>
          <p class="topic-desc">{topic.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .contact-grid { grid-template-columns: 1fr 1fr; }
  }

  .contact-narrative {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact-heading {
    font: var(--title-l);
    letter-spacing: var(--ls-title-l);
    color: var(--text-primary);
    margin: 0;
    max-width: 28ch;
  }

  .contact-desc {
    font: var(--body);
    color: var(--text-secondary);
    margin: 0;
    max-width: 60ch;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .contact-topics {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .topic-card {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .topic-title {
    font: var(--title-s);
    color: var(--text-primary);
    margin: 0;
  }

  .topic-desc {
    font: var(--body-s);
    color: var(--text-secondary);
    margin: 0;
  }
</style>

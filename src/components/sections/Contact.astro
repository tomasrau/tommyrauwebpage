---
// Contact.astro — cierre con formulario de calificación real.
//
// register-ink, no -paper: al retirar Trabajo, Trayectoria pasó a paper
// (ver Experience.astro) para no quedar dos secciones oscuras seguidas
// junto a Modelo — pero eso dejó a Trayectoria y Contacto, ambas paper,
// adyacentes y con el mismo fondo (hallazgo directo del usuario). Se
// resuelve acá, restaurando la alternancia completa de las cinco
// secciones: Research(ink) → Método(paper) → Modelo(ink) →
// Trayectoria(paper) → Contacto(ink). Todo el CSS de este componente usa
// tokens (var(--surface), var(--border-strong), etc.), así que se adapta
// solo — no hay valores fijos que revisar.
const FORMSPREE_ENDPOINT: string | null = "https://formspree.io/f/xoeqadwv";

interface Props {
  lang?: "es" | "en";
}
const { lang = "es" } = Astro.props;

const t = lang === "en"
  ? {
      num: "06",
      kicker: "Contact",
      title: "If a decision rests on a number nobody can trace, that is the conversation.",
      lead: "Consulting on quantitative research, financial analytics and the data architecture underneath both.",
      formHeading: "Start the conversation",
      name: "Name",
      namePh: "Full name",
      org: "Organisation",
      orgPh: "Company or fund",
      topic: "What do you need?",
      topics: ["Quantitative research and modelling", "Analytical architecture", "Second opinion on an existing model", "Something else"],
      message: "Context",
      messagePh: "The decision at stake, and what it currently rests on",
      submit: "Send enquiry",
      sending: "Sending…",
      disabled: "The form is not connected yet — write directly to the address below.",
      success: "Sent. You'll get a reply within two business days.",
      error: "Something went wrong sending this — write directly to the address below instead.",
      nextHeading: "What happens next",
      next: [
        "You get a reply within two business days.",
        "If it is a fit, a 30-minute call to define the question precisely.",
        "Then a written scope: what will be answered, with what data, by when.",
      ],
      includeHeading: "Worth including",
      include: [
        "The decision the analysis has to support.",
        "What data already exists, and where it lives.",
        "The deadline you are actually working against.",
      ],
      direct: "Or write directly",
    }
  : {
      num: "06",
      kicker: "Contacto",
      title: "Si una decisión se apoya en un número que nadie puede rastrear, esa es la conversación.",
      lead: "Consultoría en research cuantitativo, analítica financiera y la arquitectura de datos que sostiene a ambas.",
      formHeading: "Empecemos la conversación",
      name: "Nombre",
      namePh: "Nombre y apellido",
      org: "Organización",
      orgPh: "Empresa o fondo",
      topic: "¿Qué necesitás?",
      topics: ["Research y modelado cuantitativo", "Arquitectura analítica", "Segunda opinión sobre un modelo existente", "Otra cosa"],
      message: "Contexto",
      messagePh: "La decisión en juego y sobre qué se apoya hoy",
      submit: "Enviar consulta",
      sending: "Enviando…",
      disabled: "El formulario todavía no está conectado — escribime directo a la dirección de abajo.",
      success: "Enviado. Te respondo dentro de dos días hábiles.",
      error: "Algo falló al enviar esto — escribime directo a la dirección de abajo.",
      nextHeading: "Qué pasa después",
      next: [
        "Te respondo dentro de dos días hábiles.",
        "Si encaja, una llamada de 30 minutos para definir la pregunta con precisión.",
        "Después un alcance por escrito: qué se va a responder, con qué datos y para cuándo.",
      ],
      includeHeading: "Conviene incluir",
      include: [
        "La decisión que el análisis tiene que sostener.",
        "Qué datos ya existen y dónde viven.",
        "La fecha límite real contra la que estás trabajando.",
      ],
      direct: "O escribime directo",
    };

const email = "tomasrau@lorenz.ar";
const enabled = FORMSPREE_ENDPOINT !== null;

// Mismo número y misma convención de enlace que WhatsAppButton.astro (el
// botón flotante) — wa.me espera sólo dígitos, sin +/espacios/guiones.
const WHATSAPP_PHONE = "5491168659656";
const WHATSAPP_DISPLAY = "+54 9 11 6865-9656";
const whatsappPrefill = lang === "en"
  ? "Hi Tomás, I'm reaching out from tomasrau.ar"
  : "Hola Tomás, te escribo desde tomasrau.ar";
const whatsappHref = `https://wa.me/${WHATSAPP_PHONE}?text=${encodeURIComponent(whatsappPrefill)}`;
---

<section id="contacto" class="section register-ink">
  <div class="chapter-body">
    <div class="contact-head">
      <span class="eyebrow">{t.kicker}</span>
      <p class="contact-pull">{t.title}</p>
      <p class="contact-lead">{t.lead}</p>
    </div>

    <div class="contact-grid" data-reveal>

      <!-- ---------- Formulario ---------- -->
      <div class="form-panel">
        <span class="panel-heading">{t.formHeading}</span>

        {!enabled && <p class="form-disabled">{t.disabled}</p>}

        <form
          class="contact-form"
          method="POST"
          action={FORMSPREE_ENDPOINT ?? undefined}
          aria-describedby={enabled ? undefined : "form-disabled-note"}
          data-contact-form
        >
          <div class="field">
            <label class="field-label" for="c-name">{t.name}</label>
            <input class="field-input" type="text" id="c-name" name="name"
                   placeholder={t.namePh} autocomplete="name" required disabled={!enabled} />
          </div>

          <div class="field">
            <label class="field-label" for="c-org">{t.org}</label>
            <input class="field-input" type="text" id="c-org" name="organisation"
                   placeholder={t.orgPh} autocomplete="organization" disabled={!enabled} />
          </div>

          <div class="field">
            <label class="field-label" for="c-email">Email</label>
            <input class="field-input" type="email" id="c-email" name="email"
                   placeholder="nombre@empresa.com" autocomplete="email" required disabled={!enabled} />
          </div>

          <div class="field">
            <label class="field-label" for="c-topic">{t.topic}</label>
            <select class="field-select" id="c-topic" name="topic" disabled={!enabled}>
              {t.topics.map((topic) => <option value={topic}>{topic}</option>)}
            </select>
          </div>

          <div class="field field-wide">
            <label class="field-label" for="c-message">{t.message}</label>
            <textarea class="field-textarea" id="c-message" name="message"
                      placeholder={t.messagePh} required disabled={!enabled}></textarea>
          </div>

          <button type="submit" class="btn btn-primary submit-btn" data-submit-btn disabled={!enabled}>{t.submit}</button>
        </form>

        <p class="form-status" data-form-status role="status" aria-live="polite" hidden></p>

        <div class="direct">
          <span class="direct-label">{t.direct}</span>
          <a href={`mailto:${email}`} class="direct-link">{email}</a>
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="direct-link">
            WhatsApp · {WHATSAPP_DISPLAY}
          </a>
          <a href="https://www.linkedin.com/in/tomasezequielrau" target="_blank" rel="noopener noreferrer" class="direct-link">
            linkedin.com/in/tomasezequielrau
          </a>
        </div>
      </div>

      <!-- ---------- Qué pasa después ---------- -->
      <aside class="expect">
        <div class="expect-block">
          <h3 class="expect-title">{t.nextHeading}</h3>
          <ol class="expect-steps">
            {t.next.map((step, i) => (
              <li>
                <span class="step-num">{String(i + 1).padStart(2, "0")}</span>
                <span>{step}</span>
              </li>
            ))}
          </ol>
        </div>

        <div class="expect-block">
          <h3 class="expect-title">{t.includeHeading}</h3>
          <ul class="node-list">
            {t.include.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </aside>

    </div>
  </div>
</section>

<script>
  // Submit por fetch en vez de dejar que el navegador navegue al POST
  // directo — Formspree acepta ambos, pero un submit nativo saca al
  // visitante de este sitio de una sola página hacia la pantalla de
  // agradecimiento genérica de Formspree. Con fetch + Accept: application/json
  // (el modo AJAX que Formspree documenta) el resultado se muestra en el
  // propio panel, sin abandonar la página.
  const form = document.querySelector("[data-contact-form]") as HTMLFormElement | null;
  if (form) {
    const isEn = document.documentElement.lang === "en";
    const statusEl = document.querySelector("[data-form-status]") as HTMLElement;
    const submitBtn = form.querySelector("[data-submit-btn]") as HTMLButtonElement;
    const submitLabel = submitBtn.textContent ?? "";
    const copy = isEn
      ? {
          sending: "Sending…",
          success: "Sent. You'll get a reply within two business days.",
          error: "Something went wrong sending this — write directly to the address below instead.",
        }
      : {
          sending: "Enviando…",
          success: "Enviado. Te respondo dentro de dos días hábiles.",
          error: "Algo falló al enviar esto — escribime directo a la dirección de abajo.",
        };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = copy.sending;
      statusEl.hidden = true;
      statusEl.classList.remove("is-success", "is-error");

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!response.ok) throw new Error(`status ${response.status}`);
        statusEl.textContent = copy.success;
        statusEl.classList.add("is-success");
        statusEl.hidden = false;
        form.reset();
        form.hidden = true;
      } catch {
        statusEl.textContent = copy.error;
        statusEl.classList.add("is-error");
        statusEl.hidden = false;
        submitBtn.disabled = false;
        submitBtn.textContent = submitLabel;
      }
    });
  }
</script>

<style>
  .contact-head {
    max-width: var(--grid-max);
    margin: 0 auto;
    padding: var(--space-7) var(--page-margin) var(--space-8);
  }

  .contact-pull {
    font: var(--pullquote);
    color: var(--text-primary);
    margin: var(--space-3) 0 0;
    max-width: 26ch;
  }

  .contact-lead {
    font: var(--body-s);
    color: var(--text-secondary);
    margin: var(--space-4) 0 0;
    max-width: 52ch;
  }

  .contact-grid {
    max-width: var(--grid-max);
    margin: 0 auto;
    padding: 0 var(--page-margin);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: start;
  }


  @media (min-width: 1024px) {
    .contact-grid { grid-template-columns: 1fr var(--col-margin); gap: var(--space-8); }
  }

  /* ---- formulario ---- */

  .form-panel {
    background: var(--surface);
    border: var(--hairline) solid var(--border-strong);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .panel-heading {
    font: var(--label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-tertiary);
    padding-bottom: var(--space-3);
    border-bottom: var(--hairline) solid var(--border);
  }

  .form-disabled {
    font: var(--source);
    letter-spacing: var(--ls-source);
    color: var(--state-error);
    border-left: var(--rule) solid var(--state-error);
    padding-left: var(--space-3);
    margin: 0;
  }

  .contact-form {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .contact-form { grid-template-columns: 1fr 1fr; }
    .field-wide { grid-column: 1 / -1; }
  }

  .submit-btn { justify-self: start; margin-top: var(--space-2); }

  .contact-form :disabled { cursor: not-allowed; color: var(--state-disabled); }

  .form-status {
    font: var(--source);
    letter-spacing: var(--ls-source);
    margin: 0;
    padding-left: var(--space-3);
  }

  .form-status[hidden] { display: none; }

  .form-status.is-success { color: var(--accent); border-left: var(--rule) solid var(--accent-rule); }
  .form-status.is-error { color: var(--state-error); border-left: var(--rule) solid var(--state-error); }

  /* ---- canales directos ---- */

  .direct {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-5);
    border-top: var(--hairline) solid var(--border);
  }

  .direct-label {
    font: var(--label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .direct-link {
    font: var(--data-s);
    color: var(--text-secondary);
    text-decoration: none;
    width: fit-content;
    border-bottom: var(--hairline) solid var(--border-strong);
    padding-bottom: 2px;
    transition: color var(--dur-fast) var(--ease-in-out), border-color var(--dur-fast) var(--ease-in-out);
  }

  .direct-link:hover { color: var(--accent); border-color: var(--accent); }

  /* ---- qué pasa después ---- */

  .expect {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .expect-title {
    font: var(--label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin: 0 0 var(--space-4);
  }

  .expect-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .expect-steps li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: var(--space-3);
    font: var(--body-s);
    color: var(--text-secondary);
  }

  /* Neutral: tres numerales dorados serían tres acentos en un mismo capítulo */
  .step-num {
    font: var(--data-s);
    color: var(--text-tertiary);
  }

  /* ============================================================
     MOBILE — sólo por debajo de 640px. Desktop intacto.
     ============================================================ */
  @media (max-width: 639px) {
    /* 32px de padding a cada lado le comían 64px al panel: en un
       viewport de 390px el ancho útil quedaba en 286px y la opción
       más larga del select ("Research y modelado cuantitativo",
       ~320px a 17px) se cortaba a media palabra — verificado en
       captura. Bajarlo a 20px devuelve 24px de ancho útil y, junto
       con el ajuste de tamaño de abajo, el texto entra entero. */
    .form-panel { padding: var(--space-5); }

    /* El select es el único campo cuyo contenido no puede envolver
       ni recortarse con elipsis: o entra, o se pierde. Los demás
       campos quedan en --ui-m. */
    .field-select { font: var(--ui-s); }

    /* Los links de contacto directo son mono y largos (el de
       LinkedIn son 30 caracteres): a ancho completo de panel
       desbordaban el borde derecho. */
    .direct-link { overflow-wrap: anywhere; }

    /* El pie del formulario respira menos: en mobile cada bloque
       ya ocupa una pantalla entera, el aire de desktop sólo suma
       scroll. */
    .contact-head { padding: var(--space-8) var(--page-margin) var(--space-6); }
    .contact-grid { gap: var(--space-6); }
  }
</style>

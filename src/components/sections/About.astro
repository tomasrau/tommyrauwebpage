---
// About.astro - Sección "Marco profesional"
interface Props {
  lang?: "es" | "en";
}
const { lang = "es" } = Astro.props;

const copy = {
  es: {
    eyebrow: "Marco profesional",
    heading: "Economía aplicada, arquitectura analítica y estrategia tecnológica.",
    paragraphs: [
      'Mi trayectoria está definida por la convergencia de disciplinas tradicionalmente aisladas. Como <em>economista</em>, entiendo las dinámicas de mercado, los incentivos corporativos y los fundamentos financieros que rigen el valor de las organizaciones.',
      'La teoría económica alcanza su potencial cuando se complementa con ingeniería de datos. Por eso me especialicé en <em>arquitectura de Business Intelligence</em>: diseño canalizaciones robustas y sistemas de reporting ejecutivo que transforman datos transaccionales crudos en una única fuente de verdad.',
      'Este perfil híbrido me permite actuar como puente entre los equipos técnicos y la mesa directiva — no sólo estructurar bases de datos eficientes, sino diseñar <em>modelos analíticos</em> que guían decisiones financieras, mitigan riesgos operativos y habilitan transformación digital real.',
    ],
    pillars: [
      { title: "Razonamiento económico", desc: "Rigor metodológico para interpretar incentivos de mercado, modelar escenarios financieros y entender el contexto macro y micro que condiciona el crecimiento de una empresa." },
      { title: "Arquitectura BI", desc: "Diseño e implementación del stack de datos moderno: <em>dbt</em>, bases optimizadas, modelos estrella y reportería ejecutiva escalable, orientados a erradicar silos de información." },
      { title: "Decisión estratégica", desc: "Traducción de variables cuantitativas en planes de acción corporativos, mitigando la incertidumbre mediante modelación de sensibilidad e inteligencia de negocio." },
    ],
  },
  en: {
    eyebrow: "Professional framework",
    heading: "Applied economics, analytical architecture and technology strategy.",
    paragraphs: [
      'My work sits at the intersection of disciplines that are usually kept apart. As an <em>economist</em>, I understand market dynamics, corporate incentives and the financial fundamentals that drive organizational value.',
      'Economic theory reaches its potential when paired with data engineering. That is why I specialized in <em>Business Intelligence architecture</em>: designing robust pipelines and executive reporting systems that turn raw transactional data into a single source of truth.',
      'This hybrid profile lets me act as a bridge between technical teams and the boardroom — not just structuring efficient databases, but designing <em>analytical models</em> that guide financial decisions, mitigate operational risk and enable real digital transformation.',
    ],
    pillars: [
      { title: "Economic reasoning", desc: "Methodological rigor for interpreting market incentives, modeling financial scenarios and understanding the macro and micro context that shapes a company's growth." },
      { title: "BI architecture", desc: "Design and implementation of the modern data stack: <em>dbt</em>, optimized databases, star schemas and scalable executive reporting, aimed at eliminating information silos." },
      { title: "Strategic decision-making", desc: "Translating quantitative variables into corporate action plans, mitigating uncertainty through sensitivity modeling and business intelligence." },
    ],
  },
} as const;

const t = copy[lang];
---

<section id="about" class="section">
  <div class="section-inner about-grid">
    <div class="about-narrative">
      <span class="eyebrow">{t.eyebrow}</span>

      <h2 class="about-heading">{t.heading}</h2>

      <div class="about-copy">
        {t.paragraphs.map((p) => <p set:html={p} />)}
      </div>
    </div>

    <div class="about-pillars">
      {t.pillars.map((pillar, i) => (
        <div class="pillar card">
          <span class="pillar-index">{String(i + 1).padStart(2, "0")}</span>
          <div class="pillar-body">
            <h3 class="pillar-title">{pillar.title}</h3>
            <p class="pillar-desc" set:html={pillar.desc} />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .about-grid { grid-template-columns: 7fr 5fr; }
  }

  .about-narrative {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .about-heading {
    font: var(--title-l);
    letter-spacing: var(--ls-title-l);
    color: var(--text-primary);
    margin: 0;
    max-width: 26ch;
  }

  .about-copy {
    display: flex;
    flex-direction: column;
    gap: var(--flow-p);
    max-width: 66ch;
  }

  .about-copy p {
    font: var(--body);
    color: var(--text-secondary);
    margin: 0;
  }

  .about-copy :global(em) {
    font-style: italic;
    color: var(--text-primary);
  }

  .about-pillars {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .pillar {
    padding: var(--space-5);
    display: flex;
    gap: var(--space-4);
  }

  .pillar-index {
    font: var(--data-s);
    color: var(--text-tertiary);
    flex-shrink: 0;
  }

  .pillar-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .pillar-title {
    font: var(--title-s);
    color: var(--text-primary);
    margin: 0;
  }

  .pillar-desc {
    font: var(--body-s);
    color: var(--text-secondary);
    margin: 0;
  }

  .pillar-desc :global(em) {
    font-style: italic;
    color: var(--text-primary);
  }
</style>

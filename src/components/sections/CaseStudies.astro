---
// CaseStudies.astro - Sección "Proyectos estratégicos"
interface Props {
  lang?: "es" | "en";
}
const { lang = "es" } = Astro.props;

const copy = {
  es: {
    eyebrow: "Proyectos estratégicos",
    heading: "Sistemas, modelos e iniciativas orientadas a convertir datos en decisiones.",
    lead: "Una selección de implementaciones donde la teoría financiera y la arquitectura de datos se combinan para generar retornos cuantificables y claridad operativa.",
    impactLabel: "Impacto estratégico",
    projects: [
      { category: "Infraestructura de datos", status: "Asegurado", title: "RIO Servicios Financieros", desc: "Rediseño completo de la infraestructura de Business Intelligence: integración de múltiples bases relacionales y APIs transaccionales en un Data Warehouse unificado que centraliza el rendimiento de cartera.", impact: "Automatización del reporting mensual ejecutivo y erradicación total de discrepancias de conciliación.", tools: ["dbt", "SQL", "Power BI", "BigQuery"] },
      { category: "Modelos cuantitativos", status: "Backtested", title: "Lorenz / Plataforma de trading algorítmico", desc: "Investigación, desarrollo y backtesting de modelos cuantitativos de arbitraje basados en variables macroeconómicas y flujos de spreads de tasas de interés.", impact: "Simulación de escenarios reales con control estricto de drawdown y optimización de ejecución de órdenes vía API.", tools: ["Python", "Pandas", "NumPy", "APIs"] },
      { category: "Inteligencia financiera", status: "Optimizado", title: "Mubiz Pro Studio", desc: "Estructuración y despliegue de tableros de control ejecutivos orientados a rentabilidad unitaria por cliente, proyecciones de flujo de caja libre e inteligencia de fijación de precios dinámicos.", impact: "Visibilidad de márgenes por proyecto y renegociación comercial informada de contratos clave de proveedores.", tools: ["Power BI", "Modelos financieros", "Excel avanzado"] },
      { category: "Democratización de datos", status: "Producción", title: "BI Systems for SMEs", desc: "Consultoría estratégica y modelado de datos modular para pymes: integración de bases locales y ERPs con herramientas analíticas modernas hospedadas en la nube.", impact: "Eliminación de la dependencia de analistas de datos para auditorías de inventario diarias y decisiones operativas inmediatas.", tools: ["Power BI", "dbt Cloud", "BigQuery", "ETL automáticas"] },
    ],
  },
  en: {
    eyebrow: "Strategic projects",
    heading: "Systems, models and initiatives that convert data into decisions.",
    lead: "A selection of analytical initiatives where financial thinking and data architecture combine to create measurable returns and operational clarity.",
    impactLabel: "Strategic outcome",
    projects: [
      { category: "Data infrastructure", status: "Secured", title: "RIO Servicios Financieros", desc: "Complete redesign of the Business Intelligence infrastructure: integrating multiple relational databases and transactional APIs into a unified Data Warehouse that centralizes portfolio performance.", impact: "Executive monthly reporting automation and full elimination of reconciliation discrepancies.", tools: ["dbt", "SQL", "Power BI", "BigQuery"] },
      { category: "Quantitative models", status: "Backtested", title: "Lorenz / Algorithmic trading platform", desc: "Research, development and backtesting of quantitative arbitrage models based on macroeconomic variables and interest-rate spread flows.", impact: "Real-scenario simulation with strict drawdown control and API-based order execution optimization.", tools: ["Python", "Pandas", "NumPy", "APIs"] },
      { category: "Financial intelligence", status: "Optimized", title: "Mubiz Pro Studio", desc: "Structuring and deployment of executive control dashboards focused on unit economics, free cash flow projections and dynamic pricing intelligence.", impact: "Margin visibility by project and better-informed commercial renegotiation of key supplier contracts.", tools: ["Power BI", "Financial models", "Advanced Excel"] },
      { category: "Data democratization", status: "In production", title: "BI Systems for SMEs", desc: "Strategic consulting and modular data modeling for SMEs: connecting local databases and ERP systems with modern cloud-hosted analytical tools.", impact: "Removed dependency on data analysts for daily inventory audits and immediate operational decisions.", tools: ["Power BI", "dbt Cloud", "BigQuery", "Automated ETL"] },
    ],
  },
} as const;

const t = copy[lang];
---

<section id="proyectos" class="section">
  <div class="section-inner">
    <div class="section-header">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 class="section-heading">{t.heading}</h2>
      <p class="section-lead">{t.lead}</p>
    </div>

    <div class="projects-grid">
      {t.projects.map((p) => (
        <article class="project-card card">
          <div class="project-body">
            <div class="project-meta">
              <span class="tag tag-info">{p.category}</span>
              <span class="tag-status">{p.status}</span>
            </div>
            <h3 class="project-title">{p.title}</h3>
            <p class="project-desc">{p.desc}</p>
          </div>

          <div class="project-footer">
            <div class="project-impact">
              <span class="impact-label">{t.impactLabel}</span>
              <p class="impact-text">{p.impact}</p>
            </div>
            <div class="project-tools">
              {p.tools.map((tool) => <span class="tag tag-info">{tool}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 66ch;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gutter);
  }

  @media (min-width: 768px) {
    .projects-grid { grid-template-columns: 1fr 1fr; }
  }

  .project-card {
    height: 100%;
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .project-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .tag-status {
    font: var(--label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    padding: 4px 8px;
    border: var(--hairline) solid var(--border-strong);
    color: var(--text-secondary);
  }

  .project-title {
    font: var(--title-s);
    color: var(--text-primary);
    margin: 0;
  }

  .project-desc {
    font: var(--body-s);
    color: var(--text-secondary);
    margin: 0;
  }

  .project-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: var(--hairline) solid var(--border);
  }

  .project-impact {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .impact-label {
    font: var(--label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .impact-text {
    font: var(--ui-s);
    color: var(--text-primary);
    margin: 0;
  }

  .project-tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>

---
// Experience.astro - Sección "Trayectoria" (timeline con nodo cuadrado, §3.11)
interface Props {
  lang?: "es" | "en";
}
const { lang = "es" } = Astro.props;

const copy = {
  es: {
    eyebrow: "Trayectoria",
    heading: "Una progresión profesional entre análisis, negocio y tecnología.",
    lead: "Evolución que combina el rigor metodológico de la economía clásica con las herramientas y plataformas de Business Intelligence del stack tecnológico moderno.",
    milestones: [
      { tag: "Fundamentos cuantitativos", stage: "Etapa inicial", title: "Economía y formación estratégica", desc: "Formación rigurosa en teoría macroeconómica, econometría y modelos predictivos cuantitativos — base metodológica para el análisis de dinámicas corporativas complejas, elasticidades de mercado e interpretación de conjuntos de datos empresariales." },
      { tag: "Consolidación de datos", stage: "Etapa analítica", title: "Business Intelligence & Analytics", desc: "Especialización en el stack moderno de datos: diseño e integración de almacenes de datos analíticos, automatización de canalizaciones ETL, esquemas estrella y reportería directiva de alto nivel para autogestión de datos corporativos." },
      { tag: "Inteligencia de mercados", stage: "Especialización", title: "Financial analytics & capital markets focus", desc: "Aplicación de econometría avanzada y análisis financiero a carteras de inversión y valuación corporativa: modelado de sensibilidad a tasas, evaluación cuantitativa de activos y optimización del flujo de caja operativo." },
      { tag: "Productos y plataformas", stage: "Etapa directiva", title: "Data-driven products and strategic platforms", desc: "Diseño e impulso de plataformas digitales que centralizan información clave de negocio: análisis predictivo, IA aplicada y dashboards interactivos como tableros de control directivo." },
    ],
  },
  en: {
    eyebrow: "Experience",
    heading: "A professional progression across analysis, business and technology.",
    lead: "A structured path combining the methodological rigor of classical economics with the tools and platforms of the modern Business Intelligence stack.",
    milestones: [
      { tag: "Quantitative foundations", stage: "Initial stage", title: "Economics and strategic training", desc: "A rigorous foundation in macroeconomic theory, econometrics and quantitative predictive models — the methodological base for analyzing complex corporate dynamics, market elasticities and business data sets." },
      { tag: "Data consolidation", stage: "Analytical stage", title: "Business Intelligence & Analytics", desc: "Practical specialization in the modern data stack: design and integration of analytical data warehouses, ETL pipeline automation, star schemas and high-level executive reporting for data self-service." },
      { tag: "Market intelligence", stage: "Specialization", title: "Financial analytics & capital markets focus", desc: "Application of advanced econometrics and financial analysis to investment portfolios and corporate valuation: rate-sensitivity modeling, quantitative asset evaluation and operating cash flow optimization." },
      { tag: "Products and platforms", stage: "Strategic stage", title: "Data-driven products and strategic platforms", desc: "Design and delivery of digital platforms that centralize key business information: predictive analytics, applied AI and interactive dashboards as executive control panels." },
    ],
  },
} as const;

const t = copy[lang];
---

<section id="experiencia" class="section">
  <div class="section-inner">
    <div class="section-header">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 class="section-heading">{t.heading}</h2>
      <p class="section-lead">{t.lead}</p>
    </div>

    <ol class="timeline">
      {t.milestones.map((m) => (
        <li class="milestone">
          <span class="milestone-node" aria-hidden="true"></span>
          <div class="milestone-card card">
            <div class="milestone-meta">
              <span class="milestone-tag">{m.tag}</span>
              <span class="tag tag-info">{m.stage}</span>
            </div>
            <h3 class="milestone-title">{m.title}</h3>
            <p class="milestone-desc">{m.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 66ch;
  }

  .timeline {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0 0 0 var(--space-6);
    border-left: var(--hairline) solid var(--border);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 56rem;
  }

  .milestone {
    position: relative;
  }

  .milestone-node {
    position: absolute;
    left: calc(var(--space-6) * -1 - 5px);
    top: 6px;
    width: var(--node-point);
    height: var(--node-point);
    background: var(--text-secondary);
    border-radius: var(--radius-1);
  }

  .milestone-card {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .milestone-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .milestone-tag {
    font: var(--label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .milestone-title {
    font: var(--title-s);
    color: var(--text-primary);
    margin: 0;
  }

  .milestone-desc {
    font: var(--body-s);
    color: var(--text-secondary);
    margin: 0;
  }
</style>

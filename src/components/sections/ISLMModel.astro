  }

  .control {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 220px;
    flex: 1 1 220px;
  }

  .control-label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    font: var(--ui-s);
    letter-spacing: var(--ls-ui-s);
    color: var(--text-secondary);
  }

  .control-value {

  /* Lectura de resultado: tres cifras — el modelo tiene tres salidas
     (producción, tasa, tipo de cambio), no una sola "hero number". */
  .model-readout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    padding-top: var(--space-5);
    border-top: var(--hairline) solid var(--border);
  }

  @media (min-width: 900px) {
    .model-readout {
      flex: 0 0 32%;
      grid-template-columns: 1fr;
      gap: var(--space-5);
      align-content: center;

    flex-direction: column;
    gap: var(--space-1);
  }

  .model-def dt {
    font: var(--ui-s);
    letter-spacing: var(--ls-ui-s);
    font-weight: 600;
  }

  .model-def dd {
    font: var(--source);
    color: var(--text-secondary);
    margin: 0;
  }

  /* ---- la pieza: chart + lectura de resultado ---- */

  .model-visual {

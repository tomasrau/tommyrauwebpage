    display: flex;
    flex-direction: column;
  }

  @media (min-width: 900px) {
    .chart-plot { flex: 1 1 64%; min-height: 0; }
  }

  .chart-caption {
    display: block;
    font: var(--label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-tertiary);

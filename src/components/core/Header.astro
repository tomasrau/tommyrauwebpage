---
// Header.astro — sin barra (rediseño 2026-08-20).
//
// Ya no hay header: hay DOS piezas flotantes, una en cada esquina superior
// — la marca a la izquierda, los controles reales a la derecha (⌘K, idioma,
// tema). La navegación por secciones ya no pasa por acá: el grafo del mapa
// del sitio (NavHub.astro) se retiró — "no está bien logrado", feedback
// directo del usuario — y en su lugar vive FloatingNav.astro, una píldora
// flotante propia abajo al centro, sólo en las páginas de la landing.
//
// Flotan de verdad (position: fixed + --shadow-float, la única sombra que
// el sistema permite y sólo para elementos flotantes). Sin backdrop-filter:
// el glassmorphism está prohibido — las píldoras van sobre superficie
// sólida.
import logoOnLight from "../../assets/media/logos/logo_black_cropped.png";
import logoOnDark from "../../assets/media/logos/logo_white_cropped.png";

interface Props {
  lang?: "es" | "en";
  alternateUrl?: string;
}

const { lang = "es", alternateUrl = lang === "es" ? "/en/" : "/" } = Astro.props;

const t = lang === "en"
  ? {
      ariaHome: "Back to home",
      switcher: "Language selector",
      theme: "Toggle light and dark theme",
      search: "Jump to…",
    }
  : {
      ariaHome: "Volver al inicio",
      switcher: "Selector de idioma",
      theme: "Cambiar tema claro u oscuro",
      search: "Saltar a…",
    };
---

<a href="#inicio" class="float-brand" aria-label={t.ariaHome}>
  <span class="brand-mark" aria-hidden="true">
    <img class="brand-ink brand-ink-on-light" src={logoOnLight.src} alt="" width={logoOnLight.width} height={logoOnLight.height} loading="eager" decoding="async" />
    <img class="brand-ink brand-ink-on-dark" src={logoOnDark.src} alt="" width={logoOnDark.width} height={logoOnDark.height} loading="eager" decoding="async" />
  </span>
</a>

<div class="float-controls">
  <button type="button" class="cmdk-trigger" data-cmdk-trigger aria-label={t.search}>
    <kbd class="cmdk-trigger-key">⌘K</kbd>
  </button>

  <nav class="lang-switch" aria-label={t.switcher}>
    {lang === "es"
      ? <span class="lang-option is-current" aria-current="true">es</span>
      : <a href={alternateUrl} class="lang-option" aria-label="Ver sitio en español">es</a>}
    <span class="lang-sep" aria-hidden="true">/</span>
    {lang === "en"
      ? <span class="lang-option is-current" aria-current="true">en</span>
      : <a href={alternateUrl} class="lang-option" aria-label="View site in English">en</a>}
  </nav>

  <button type="button" class="theme-toggle" aria-label={t.theme} aria-pressed="false" data-theme-toggle>
    <svg class="theme-icon theme-icon-light" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <circle cx="12" cy="12" r="4.2"></circle>
      <path d="M12 2.6v2.2M12 19.2v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.6 12h2.2M19.2 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6"></path>
    </svg>
    <svg class="theme-icon theme-icon-dark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3a6 6 0 0 0 9 7.5A9 9 0 1 1 12 3Z"></path>
    </svg>
  </button>
</div>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const button = document.querySelector("[data-theme-toggle]");
    if (!button) return;

    const sync = (theme) => button.setAttribute("aria-pressed", theme === "light" ? "true" : "false");
    sync(root.dataset.theme === "dark" ? "dark" : "light");

    button.addEventListener("click", () => {
      const next = root.dataset.theme === "light" ? "dark" : "light";
      root.dataset.theme = next;
      try { localStorage.setItem("theme", next); } catch {}
      sync(next);
    });
  })();
</script>

<style>
  /* ---------- las dos piezas flotantes ---------- */

  .float-brand,
  .float-controls {
    position: fixed;
    top: var(--space-4);
    z-index: 60;
    display: flex;
    align-items: center;
    background: var(--surface-raised);
    border: var(--hairline) solid var(--border);
    border-radius: var(--radius-2);
    box-shadow: var(--shadow-float);
  }

  .float-brand {
    left: var(--space-4);
    padding: 9px 14px;
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-in-out);
  }
  .float-brand:hover { border-color: var(--border-strong); }
  .float-brand:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-offset); }

  .float-controls {
    right: var(--space-4);
    gap: var(--space-4);
    padding: 8px 14px;
  }

  @media (min-width: 900px) {
    .float-brand, .float-controls { top: var(--space-5); }
    .float-brand { left: var(--space-5); }
    .float-controls { right: var(--space-5); }
  }

  /* ---------- marca ---------- */

  .brand-mark {
    position: relative;
    display: block;
    width: 132px;
    height: 25px;
  }

  .brand-ink {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: left center;
  }

  /* ---------- controles ---------- */

  .cmdk-trigger {
    display: none;
    align-items: center;
    background: none;
    border: var(--hairline) solid var(--border);
    border-radius: var(--radius-1);
    padding: 4px 9px;
    cursor: pointer;
    color: var(--text-tertiary);
    transition: color var(--dur-fast) var(--ease-in-out), border-color var(--dur-fast) var(--ease-in-out);
  }
  @media (min-width: 900px) { .cmdk-trigger { display: flex; } }
  .cmdk-trigger:hover { border-color: var(--border-strong); color: var(--text-primary); }
  .cmdk-trigger:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-offset); }

  .cmdk-trigger-key {
    font-family: var(--font-data);
    font-size: 13px;
    letter-spacing: 0.04em;
  }

  .lang-switch {
    display: none;
    align-items: center;
    gap: 6px;
    font-family: var(--font-data);
    font-size: 14px;
  }
  @media (min-width: 640px) { .lang-switch { display: flex; } }

  .lang-sep { color: var(--border-strong); }

  .lang-option {
    color: var(--text-tertiary);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-in-out);
  }
  .lang-option:hover { color: var(--text-primary); }
  .lang-option.is-current { color: var(--accent); }
  .lang-option:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-offset); }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 0;
    padding: 2px;
    cursor: pointer;
    color: var(--text-tertiary);
    transition: color var(--dur-fast) var(--ease-in-out);
  }
  .theme-toggle:hover { color: var(--accent); }
  .theme-toggle:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-offset); }
  .theme-toggle svg { width: 18px; height: 18px; }

  /* MOBILE — el conmutador es el único control que queda en la píldora
     derecha por debajo de 640px (⌘K y el selector de idioma se ocultan
     antes), y medía 22×22px de área tocable: por debajo del piso de
     WCAG 2.5.8 (24px) y muy lejos de los 44px que los sliders del
     modelo sí respetan en este mismo sitio. El ícono no cambia de
     tamaño — sólo crece el área que recibe el dedo. */
  @media (max-width: 899px) and (pointer: coarse) {
    .theme-toggle {
      min-width: 44px;
      min-height: 44px;
      margin: -11px -8px;
    }
  }
</style>

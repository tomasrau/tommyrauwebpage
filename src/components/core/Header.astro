---
// Header.astro - Sticky header floating navigation bar
---

<header class="fixed top-0 left-0 right-0 w-full z-50 p-4 md:p-6 pointer-events-none">
  <!-- Capsule layout wrapper with pointer-events restoration -->
  <div class="w-full max-w-7xl mx-auto pointer-events-auto">
    <div class="glass-surface px-5 py-4 md:px-8 flex items-center justify-between border border-white/5 rounded-2xl shadow-xl shadow-obsidian-bg/40 backdrop-blur-md transition-all duration-300">
      
      <!-- Brand Logo Indicator -->
      <a href="#inicio" class="flex flex-col gap-0.5 group focus:outline-none" aria-label="Volver al inicio">
        <span class="font-display font-extrabold text-slate-100 text-lg md:text-xl tracking-tight leading-none transition-colors duration-200 group-hover:text-accent-bronze">
          Tomás Rau
        </span>
        <span class="text-[9px] font-mono tracking-widest text-muted uppercase">
          Economista · BI · Finanzas
        </span>
      </a>

      <!-- Desktop Navigation Links (hidden on mobile) -->
      <nav class="hidden md:flex items-center gap-8" aria-label="Navegación principal">
        <a 
          href="#inicio" 
          class="text-sm font-display font-medium text-slate-300 hover:text-accent-bronze transition-colors duration-200 focus:outline-none"
        >
          Inicio
        </a>
        <a 
          href="#expertise" 
          class="text-sm font-display font-medium text-slate-300 hover:text-accent-bronze transition-colors duration-200 focus:outline-none"
        >
          Expertise
        </a>
        <a 
          href="#proyectos" 
          class="text-sm font-display font-medium text-slate-300 hover:text-accent-bronze transition-colors duration-200 focus:outline-none"
        >
          Proyectos
        </a>
        <a 
          href="#contacto" 
          class="text-sm font-display font-medium text-slate-300 hover:text-accent-bronze transition-colors duration-200 focus:outline-none"
        >
          Contacto
        </a>
      </nav>

      <!-- Right Side CTA Link -->
      <div class="flex items-center">
        <a 
          href="#contacto" 
          class="px-4 py-2 rounded-lg bg-accent-bronze hover:bg-accent-bronze-hover text-obsidian-bg font-display font-bold text-xs tracking-wider uppercase transition-all duration-200 focus:outline-none shadow-md shadow-accent-bronze/10 hover:shadow-lg hover:shadow-accent-bronze/20 active:scale-[0.98]"
        >
          Hablemos
        </a>
      </div>

    </div>
  </div>
</header>

---
// Header.astro - Cabecera de una línea (§3.7 del design system): sin fondo propio ni
// sombra al hacer scroll, isotipo + nombre, nav en --ui-l, filete petróleo en el activo.
import logoBlack from "../../assets/media/logos/logo_black_cropped.png";
import logoWhite from "../../assets/media/logos/logo_white_cropped.png";

interface Props {
  lang?: "es" | "en";
  alternateUrl?: string;
}

const { lang = "es", alternateUrl = lang === "es" ? "/en/" : "/" } = Astro.props;

const labels = lang === "en"
  ? {
      home: "Home",
      expertise: "Expertise",
      projects: "Projects",
      contact: "Contact",
      cta: "Let's talk",
      brand: "Economist · BI · Finance",
      ariaHome: "Back to home",
      ariaNav: "Main navigation",
      switcher: "Language selector",
      menu: "Open navigation menu",
      theme: "Toggle light and dark theme",
    }
  : {
      home: "Inicio",
      expertise: "Expertise",
      projects: "Proyectos",
      contact: "Contacto",
      cta: "Hablemos",
      brand: "Economista · BI · Finanzas",
      ariaHome: "Volver al inicio",
      ariaNav: "Navegación principal",
      switcher: "Selector de idioma",
      menu: "Abrir menú de navegación",
      theme: "Cambiar tema claro u oscuro",
    };

const esActive = lang === "es";
const enActive = lang === "en";
---

<header class="site-header">
  <div class="site-header-inner">

    <a href="#inicio" class="brand" aria-label={labels.ariaHome}>
      <span class="brand-lockup" aria-hidden="true">
        <img class="brand-logo brand-logo-dark" src={logoWhite.src} alt="" width={logoWhite.width} height={logoWhite.height} loading="eager" decoding="async" />
        <img class="brand-logo brand-logo-light" src={logoBlack.src} alt="" width={logoBlack.width} height={logoBlack.height} loading="eager" decoding="async" />
      </span>
      <span class="brand-tag">{labels.brand}</span>
    </a>

    <nav class="main-nav" aria-label={labels.ariaNav}>
      <a href="#inicio" class="nav-link is-active">{labels.home}</a>
      <a href="#expertise" class="nav-link">Expertise</a>
      <a href="#proyectos" class="nav-link">{labels.projects}</a>
      <a href="#contacto" class="nav-link">{labels.contact}</a>
    </nav>

    <div class="controls">
      <nav class="lang-switch" aria-label={labels.switcher}>
        {esActive ? (
          <span class="lang-option is-current" aria-current="true">ES</span>
        ) : (
          <a href={alternateUrl} class="lang-option" aria-label="Ver sitio en español">ES</a>
        )}
        {enActive ? (
          <span class="lang-option is-current" aria-current="true">EN</span>
        ) : (
          <a href={alternateUrl} class="lang-option" aria-label="View site in English">EN</a>
        )}
      </nav>

      <button type="button" class="theme-toggle" aria-label={labels.theme} aria-pressed="false" data-theme-toggle>
        <svg class="theme-icon theme-icon-dark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 7.5A9 9 0 1 1 12 3Z"></path>
        </svg>
        <svg class="theme-icon theme-icon-light" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path><path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path><path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
      </button>

      <a href="#contacto" class="cta-button">{labels.cta}</a>

      <details class="mobile-menu">
        <summary class="mobile-menu-trigger" aria-label={labels.menu}>
          <span class="burger" aria-hidden="true">
            <span></span><span></span><span></span>
          </span>
        </summary>
        <nav class="mobile-menu-panel" aria-label={labels.ariaNav}>
          <a href="#inicio" class="mobile-link">{labels.home}</a>
          <a href="#expertise" class="mobile-link">Expertise</a>
          <a href="#proyectos" class="mobile-link">{labels.projects}</a>
          <a href="#contacto" class="mobile-link">{labels.contact}</a>
          <a href="#contacto" class="cta-button mobile-cta">{labels.cta}</a>
        </nav>
      </details>
    </div>

  </div>
</header>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const button = document.querySelector("[data-theme-toggle]");
    if (!button) return;

    const applyTheme = (theme) => {
      root.dataset.theme = theme;
      try {
        localStorage.setItem("theme", theme);
      } catch {}
      button.setAttribute("aria-pressed", theme === "light" ? "true" : "false");
    };

    const currentTheme = root.dataset.theme === "dark" ? "dark" : "light";
    button.setAttribute("aria-pressed", currentTheme === "light" ? "true" : "false");
    button.addEventListener("click", () => {
      applyTheme(root.dataset.theme === "light" ? "dark" : "light");
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: var(--hairline) solid var(--border);
  }

  .site-header-inner {
    max-width: var(--grid-max);
    margin: 0 auto;
    padding: var(--space-3) var(--page-margin);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .brand {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--space-1);
    text-decoration: none;
  }

  .brand-lockup {
    position: relative;
    display: block;
    height: 28px;
    width: 148px;
    flex-shrink: 0;
  }

  .brand-logo {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: contain;
    object-position: left;
  }

  [data-theme="light"] .brand-logo-dark,
  :root:not([data-theme="dark"]) .brand-logo-dark { opacity: 0; }
  [data-theme="dark"] .brand-logo-light { opacity: 0; }

  .brand-tag {
    display: none;
    font: var(--label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  @media (min-width: 640px) {
    .brand-tag { display: inline; }
  }

  .main-nav {
    display: none;
    align-items: center;
    gap: var(--space-3);
  }

  @media (min-width: 1024px) {
    .main-nav { display: flex; }
  }

  .nav-link {
    font: var(--ui-l);
    padding: 10px 14px;
    color: var(--text-secondary);
    text-decoration: none;
    box-shadow: inset 0 -2px 0 transparent;
    transition: color var(--dur-fast) var(--ease-in-out), box-shadow var(--dur-fast) var(--ease-in-out);
  }

  .nav-link:hover {
    color: var(--text-primary);
    box-shadow: inset 0 -2px 0 var(--border-strong);
  }

  .nav-link.is-active {
    color: var(--text-primary);
    box-shadow: inset 0 -2px 0 var(--text-primary);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .lang-switch {
    display: flex;
    align-items: center;
    gap: 2px;
    border: var(--hairline) solid var(--border);
    padding: 2px;
  }

  .lang-option {
    font: var(--label);
    letter-spacing: var(--ls-label);
    padding: 5px 9px;
    color: var(--text-tertiary);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-in-out), color var(--dur-fast) var(--ease-in-out);
  }

  .lang-option:hover { color: var(--text-primary); }

  .lang-option.is-current {
    background: var(--text-primary);
    color: var(--surface);
  }

  .theme-toggle {
    display: flex;
    height: 36px;
    width: 36px;
    align-items: center;
    justify-content: center;
    border: var(--hairline) solid var(--border);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-in-out), color var(--dur-fast) var(--ease-in-out);
  }

  .theme-toggle:hover {
    border-color: var(--border-strong);
    color: var(--text-primary);
  }

  .theme-icon { width: 16px; height: 16px; }
  :root:not([data-theme="dark"]) .theme-icon-dark { display: none; }
  [data-theme="dark"] .theme-icon-light { display: none; }

  .cta-button {
    display: none;
    white-space: nowrap;
    padding: 10px 18px;
    height: 44px;
    align-items: center;
    background: var(--text-primary);
    color: var(--surface);
    border: var(--hairline) solid var(--text-primary);
    border-radius: var(--radius-2);
    font: var(--ui-m);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-in-out), border-color var(--dur-fast) var(--ease-in-out);
  }

  @media (min-width: 1024px) {
    .cta-button { display: inline-flex; }
  }

  .cta-button:hover {
    background: var(--petrol-800);
    border-color: var(--petrol-800);
    color: var(--surface);
  }

  .cta-button:active {
    background: var(--petrol-950);
    border-color: var(--petrol-950);
  }

  .mobile-menu { position: relative; }

  @media (min-width: 1024px) {
    .mobile-menu { display: none; }
  }

  .mobile-menu-trigger {
    display: flex;
    height: 36px;
    width: 36px;
    cursor: pointer;
    list-style: none;
    align-items: center;
    justify-content: center;
    border: var(--hairline) solid var(--border);
    color: var(--text-primary);
  }

  .mobile-menu-trigger::-webkit-details-marker { display: none; }

  .burger {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .burger span {
    display: block;
    height: 1.5px;
    width: 16px;
    background: currentColor;
  }

  .mobile-menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-3));
    display: flex;
    width: min(16rem, calc(100vw - var(--space-5) * 2));
    flex-direction: column;
    background: var(--surface-raised);
    border: var(--hairline) solid var(--border-strong);
    box-shadow: var(--shadow-float);
    padding: var(--space-2);
  }

  .mobile-link {
    padding: var(--space-3) var(--space-4);
    font: var(--ui-l);
    color: var(--text-secondary);
    text-decoration: none;
  }

  .mobile-link:hover {
    background: var(--state-hover);
    color: var(--text-primary);
  }

  .mobile-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-1);
  }
</style>

---
// Footer.astro - Pie de página plano, sin blur/gradiente, con divisor de nodo (§3.11).
import logoBlack from "../../assets/media/logos/logo_black_cropped.png";
import logoWhite from "../../assets/media/logos/logo_white_cropped.png";
import isotypeBlack from "../../assets/media/logos/isotype_black_cropped.png";
import isotypeWhite from "../../assets/media/logos/isotype_white_cropped.png";

interface Props {
  lang?: "es" | "en";
}
const { lang = "es" } = Astro.props;

const copy = {
  es: {
    ariaHome: "Volver al inicio",
    tag: "Economía · BI · Finanzas · Tecnología estratégica",
    desc: "Rigurosidad cuantitativa, analítica de datos y visión financiera corporativa aplicadas a decisiones estratégicas de alto impacto.",
    navHeading: "Navegación",
    ariaNav: "Navegación del pie de página",
    home: "Inicio",
    projects: "Proyectos",
    contact: "Contacto",
    connectHeading: "Conectar",
    copyright: "Todos los derechos reservados.",
  },
  en: {
    ariaHome: "Back to home",
    tag: "Economics · BI · Finance · Strategic technology",
    desc: "Quantitative rigor, data analytics and corporate financial vision applied to high-impact strategic decisions.",
    navHeading: "Navigation",
    ariaNav: "Footer navigation",
    home: "Home",
    projects: "Projects",
    contact: "Contact",
    connectHeading: "Connect",
    copyright: "All rights reserved.",
  },
} as const;

const t = copy[lang];
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="node-divider" aria-hidden="true">
    <span class="node-dot"></span>
    <span class="node-line"></span>
  </div>

  <div class="footer-inner">

    <div class="footer-top">
      <div class="footer-identity">
        <a href="#inicio" class="brand" aria-label={t.ariaHome}>
          <span class="brand-lockup" aria-hidden="true">
            <img class="brand-logo brand-logo-dark" src={logoWhite.src} alt="" width={logoWhite.width} height={logoWhite.height} loading="lazy" decoding="async" />
            <img class="brand-logo brand-logo-light" src={logoBlack.src} alt="" width={logoBlack.width} height={logoBlack.height} loading="lazy" decoding="async" />
          </span>
        </a>
        <span class="brand-tag">{t.tag}</span>
        <p class="footer-desc">{t.desc}</p>
      </div>

      <div class="footer-links">
        <div class="link-group">
          <span class="link-heading">{t.navHeading}</span>
          <nav class="link-list" aria-label={t.ariaNav}>
            <a href="#inicio" class="footer-link">{t.home}</a>
            <a href="#expertise" class="footer-link">Expertise</a>
            <a href="#proyectos" class="footer-link">{t.projects}</a>
            <a href="#contacto" class="footer-link">{t.contact}</a>
          </nav>
        </div>

        <div class="link-group">
          <span class="link-heading">{t.connectHeading}</span>
          <div class="link-list">
            <a href="https://www.linkedin.com/in/tomasezequielrau" target="_blank" rel="noopener noreferrer" class="footer-link">LinkedIn</a>
            <a href="https://github.com/tomasrau" target="_blank" rel="noopener noreferrer" class="footer-link">GitHub</a>
            <a href="mailto:tomasrau@lorenz.ar" class="footer-link">Email</a>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-rule"></div>

    <div class="footer-bottom">
      <span class="copyright">&copy; {currentYear} Tomás Rau. {t.copyright}</span>
      <span class="signature">
        <span class="signature-mark" aria-hidden="true">
          <img class="brand-logo brand-logo-dark" src={isotypeWhite.src} alt="" width={isotypeWhite.width} height={isotypeWhite.height} loading="lazy" decoding="async" />
          <img class="brand-logo brand-logo-light" src={isotypeBlack.src} alt="" width={isotypeBlack.width} height={isotypeBlack.height} loading="lazy" decoding="async" />
        </span>
        tomasrau.ar · Quantitative Architecture
      </span>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    margin-top: auto;
    background: var(--bg);
    position: relative;
  }

  .node-divider {
    display: flex;
    align-items: center;
    max-width: var(--grid-max);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .node-dot {
    width: var(--node-dot);
    height: var(--node-dot);
    background: var(--text-secondary);
    flex-shrink: 0;
  }

  .node-line {
    height: var(--hairline);
    width: 100%;
    background: var(--border);
  }

  .footer-inner {
    max-width: var(--grid-max);
    margin: 0 auto;
    padding: var(--space-6) var(--page-margin) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
  }

  @media (min-width: 1024px) {
    .footer-top { flex-direction: row; align-items: flex-start; }
  }

  .footer-identity {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 28rem;
  }

  .brand-lockup {
    position: relative;
    display: block;
    height: 34px;
    width: 178px;
  }

  .brand-logo {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: contain;
    object-position: left;
  }

  :root:not([data-theme="dark"]) .brand-logo-dark { opacity: 0; }
  [data-theme="dark"] .brand-logo-light { opacity: 0; }

  .brand-tag {
    font: var(--label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .footer-desc {
    font: var(--body-s);
    color: var(--text-secondary);
    margin: var(--space-1) 0 0;
    max-width: 40ch;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6) var(--space-9);
  }

  .link-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .link-heading {
    font: var(--label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .link-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-link {
    font: var(--ui-s);
    color: var(--text-secondary);
    text-decoration: none;
  }

  .footer-link:hover { color: var(--accent); }

  .footer-rule {
    height: var(--hairline);
    background: var(--border);
    width: 100%;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .footer-bottom { flex-direction: row; align-items: center; justify-content: space-between; }
  }

  .copyright {
    font: var(--ui-s);
    color: var(--text-tertiary);
  }

  .signature {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font: var(--source);
    letter-spacing: var(--ls-source);
    color: var(--text-tertiary);
  }

  .signature-mark {
    position: relative;
    display: block;
    height: 16px;
    width: 16px;
    flex-shrink: 0;
  }
</style>

---
// Footer.astro — pie del sitio, dirección "panel técnico" (elegida
// explícitamente por el usuario entre dos opciones — la otra era un cierre
// editorial silencioso, tipo colofón de revista).
//
// Historial de esta pieza, para no repetir los mismos dos pasos en falso:
// 1er intento — sólo cambiar puntuación/tipografía sobre el mismo
//    esqueleto flexbox de siempre (identidad izquierda, links derecha).
//    El usuario lo señaló como indistinguible del footer viejo.
// 2do intento — sumar `.register-invert` (banda de color siempre contraria
//    al tema, mismo mecanismo que usaba la consola del viejo mapa del
//    sitio). Es una mejora real pero seguía siendo "el mismo layout con
//    otro fondo" — el usuario lo rechazó explícitamente por eso.
// 3ero (éste) — la pieza que faltaba es ESTRUCTURA, no color: el
// contenido ahora vive dentro de un panel real con borde, barra de título
// (mismo patrón `<header>` + punto + label que cada panel de
// BootTerminal.astro) y tres columnas separadas por líneas verticales, no
// bloques flexbox sueltos. `.register-invert` se mantiene — la banda de
// color le da atmósfera, el panel con grilla le da estructura; ninguna de
// las dos cosas sola alcanzaba.
import logoOnLight from "../../assets/media/logos/logo_black_cropped.png";
import logoOnDark from "../../assets/media/logos/logo_white_cropped.png";

interface Props {
  lang?: "es" | "en";
}
const { lang = "es" } = Astro.props;

const t = lang === "en"
  ? {
      ariaHome: "Back to home",
      titlebar: "TOMASRAU.AR",
      tag: "Economics · Capital markets · Quantitative research",
      desc: "Quantitative rigor, data architecture and financial judgement applied to decisions that carry consequence.",
      navHeading: "Sections",
      ariaNav: "Footer navigation",
      nav: [
        { id: "research", label: "Research" },
        { id: "metodo", label: "Method" },
        { id: "modelo", label: "Model" },
        { id: "trayectoria", label: "Trajectory" },
        { id: "contacto", label: "Contact" },
      ],
      channelsHeading: "Elsewhere",
      copyright: "All rights reserved.",
    }
  : {
      ariaHome: "Volver al inicio",
      titlebar: "TOMASRAU.AR",
      tag: "Economía · Mercados de capitales · Research cuantitativo",
      desc: "Rigor cuantitativo, arquitectura de datos y criterio financiero aplicados a decisiones que tienen consecuencia.",
      navHeading: "Secciones",
      ariaNav: "Navegación del pie de página",
      nav: [
        { id: "research", label: "Research" },
        { id: "metodo", label: "Método" },
        { id: "modelo", label: "Modelo" },
        { id: "trayectoria", label: "Trayectoria" },
        { id: "contacto", label: "Contacto" },
      ],
      channelsHeading: "En otros lados",
      copyright: "Todos los derechos reservados.",
    };

// Contacto como dato real (kicker + valor), no sólo el nombre del canal —
// mismo patrón que cualquier campo de un panel del sitio (BootTerminal, el
// panel de riesgo del modelo).
const channels = [
  { kicker: "EMAIL", value: "tomasrau@lorenz.ar", href: "mailto:tomasrau@lorenz.ar", external: false },
  { kicker: "LINKEDIN", value: "tomasezequielrau", href: "https://www.linkedin.com/in/tomasezequielrau", external: true },
  { kicker: "GITHUB", value: "tomasrau", href: "https://github.com/tomasrau", external: true },
  { kicker: "INSTAGRAM", value: "tommyrau_", href: "https://www.instagram.com/tommyrau_/", external: true },
];

const currentYear = new Date().getFullYear();
---

<footer class="site-footer register-invert">
  <div class="footer-frame">

    <header class="footer-titlebar">
      <span class="footer-dot" aria-hidden="true"></span>
      <span class="footer-titlebar-label">{t.titlebar}</span>
    </header>

    <div class="footer-grid">
      <div class="footer-col footer-col-identity">
        <a href="#inicio" class="brand-mark-link" aria-label={t.ariaHome}>
          <span class="brand-mark" aria-hidden="true">
            <img class="brand-ink brand-ink-on-light" src={logoOnLight.src} alt="" width={logoOnLight.width} height={logoOnLight.height} loading="lazy" decoding="async" />
            <img class="brand-ink brand-ink-on-dark" src={logoOnDark.src} alt="" width={logoOnDark.width} height={logoOnDark.height} loading="lazy" decoding="async" />
          </span>
        </a>
        <span class="brand-tag">{t.tag}</span>
        <p class="footer-desc">{t.desc}</p>
      </div>

      <div class="footer-col footer-col-nav">
        <span class="footer-col-heading">{t.navHeading}</span>
        <nav class="footer-nav-list" aria-label={t.ariaNav}>
          {t.nav.map((item) => (
            <a href={`#${item.id}`} class="footer-nav-link">{item.label}</a>
          ))}
        </nav>
      </div>

      <div class="footer-col footer-col-contact">
        <span class="footer-col-heading">{t.channelsHeading}</span>
        <div class="channel-list">
          {channels.map((ch) => (
            <a
              href={ch.href}
              class="channel"
              target={ch.external ? "_blank" : undefined}
              rel={ch.external ? "noopener noreferrer" : undefined}
            >
              <span class="channel-kicker">{ch.kicker}</span>
              <span class="channel-value">{ch.value}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="copyright">&copy; {currentYear} Tomás Rau. {t.copyright}</span>
    </div>

  </div>
</footer>

<style>
  /* La BANDA (register-invert) da atmósfera de color; el PANEL de acá
     adentro da estructura. Margen alrededor del panel a propósito: dentro
     de la banda, no a sangre completa — se lee como un instrumento
     flotando en su propio registro, el mismo efecto que el mapa del sitio
     retirado lograba con su consola, pero sin el grafo. */
  .site-footer {
    width: 100%;
    margin-top: auto;
    padding: var(--space-7) var(--page-margin);
  }

  .footer-frame {
    max-width: var(--grid-max);
    margin: 0 auto;
    border: var(--hairline) solid var(--border-strong);
    /* --surface-raised, no --surface: medido tras la revisión, la
       diferencia bg↔surface dentro de .register-invert es de apenas ~3%
       de luminancia — a simple vista un solo campo de color, el panel se
       distinguía sólo por el borde. --surface-raised da un salto real. */
    background: var(--surface-raised);
  }

  /* ---- barra de título: mismo patrón que cada <header class="term-head">
     de BootTerminal.astro (punto + label mono), no un elemento nuevo ---- */

  .footer-titlebar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 9px var(--space-4);
    border-bottom: var(--hairline) solid var(--border);
    font-family: var(--font-data);
    font-size: 10px;
    letter-spacing: 0.12em;
  }

  /* Pulso sostenido, no decorativo: es la misma señal de "instrumento
     activo" que ya usaba el punto del extinto mapa del sitio — acá vive
     local al componente porque aquel keyframe global se borró junto con
     el grafo. */
  @keyframes footer-dot-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.4; transform: scale(0.82); }
  }

  .footer-dot {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    background: var(--accent-rule);
    animation: footer-dot-pulse 2.2s var(--ease-in-out) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-dot { animation: none; }
  }

  .footer-titlebar-label {
    color: var(--text-secondary);
    text-transform: uppercase;
  }

  /* ---- grilla de tres columnas reales, separadas por línea vertical —
     no bloques flexbox flotando con espacio entre ellos ---- */

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .footer-grid { grid-template-columns: 1.3fr 1fr 1fr; }
  }

  .footer-col {
    padding: var(--space-6) var(--space-5);
    border-bottom: var(--hairline) solid var(--border);
    min-width: 0;
  }

  @media (min-width: 900px) {
    .footer-col {
      border-bottom: 0;
      border-right: var(--hairline) solid var(--border);
    }
    .footer-col:last-child { border-right: 0; }
  }

  .footer-col-identity {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .brand-mark {
    position: relative;
    display: block;
    height: 30px;
    width: 158px;
  }

  .brand-tag {
    font: var(--label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .footer-desc {
    font: var(--body-s);
    color: var(--text-secondary);
    margin: var(--space-2) 0 0;
    max-width: 40ch;
  }

  .footer-col-heading {
    display: block;
    font: var(--label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: var(--space-4);
  }

  .footer-nav-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-nav-link {
    font: var(--ui-s);
    letter-spacing: var(--ls-ui-s);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-in-out);
  }
  .footer-nav-link:hover { color: var(--accent); }
  .footer-nav-link:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-offset); }

  /* ---- canales de contacto: kicker + valor real, no sólo el nombre del
     canal ---- */

  .channel-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .channel {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
  }

  .channel-kicker {
    font-family: var(--font-data);
    font-size: 9px;
    letter-spacing: 0.13em;
    color: var(--text-tertiary);
  }

  .channel-value {
    font-family: var(--font-data);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--text-secondary);
    transition: color var(--dur-fast) var(--ease-in-out);
  }

  .channel:hover .channel-value { color: var(--accent); }
  .channel:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-offset); }

  /* ---- barra inferior ---- */

  .footer-bottom {
    padding: var(--space-3) var(--space-4);
    border-top: var(--hairline) solid var(--border-strong);
  }

  .copyright {
    font: var(--source);
    letter-spacing: var(--ls-source);
    color: var(--text-tertiary);
  }
</style>

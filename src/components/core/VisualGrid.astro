---
// VisualGrid.astro - Trama de fondo derivada del isotipo (§3.11 del design system).
// Sólo se monta dentro del hero/portada — nunca detrás de texto de lectura ni de tarjetas.
---

<div class="node-trama" aria-hidden="true">
  <svg class="node-trama-svg" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="node-grid" width="32" height="32" patternUnits="userSpaceOnUse">
        <path d="M 32 0 L 0 0 0 32" fill="none" stroke="var(--border)" stroke-width="1" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#node-grid)" />
    <!-- Camino escaso de nodos, sólo ortogonal y 45° -->
    <g stroke="var(--border-strong)" stroke-width="1" fill="none">
      <path d="M 64 96 H 224 L 288 160 V 320" />
      <path d="M 64 96 H 224 L 288 160 V 320" transform="translate(0, 0)" />
    </g>
    <g fill="var(--text-tertiary)">
      <rect x="60" y="92" width="8" height="8" />
      <rect x="220" y="92" width="8" height="8" />
      <rect x="284" y="156" width="8" height="8" />
      <rect x="284" y="316" width="8" height="8" />
    </g>
  </svg>
</div>

<style>
  .node-trama {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .node-trama-svg {
    width: 100%;
    height: 100%;
    opacity: 0.55;
  }
</style>
